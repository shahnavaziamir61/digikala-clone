{
  "name": "horology-engineering",
  "version": "0.1.0",
  "private": true,
  "description": "Parametric Mechanical Watch Design & Simulation Environment",
  "workspaces": [
    "packages/engineering-core",
    "packages/backend",
    "packages/frontend",
    "packages/cad-adapter"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspace=@horology/backend",
    "dev:frontend": "npm run dev --workspace=@horology/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
