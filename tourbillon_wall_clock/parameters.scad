// ===========================================================================
//  parameters.scad  --  ALL user-editable parameters of the tourbillon wall
//                       clock, in one place.
//
//  Units      : millimetres throughout.
//  Axes       : Z is perpendicular to the dial, XY is the dial plane,
//               and the model is viewed from the FRONT (+Z towards you).
//               +Y is 12 o'clock.
//
//  This file is HAND WRITTEN.  The derived numbers it needs (tooth counts,
//  centre distances, speeds, spring torque, masses ...) live in
//  parameters_auto.scad, which is MACHINE GENERATED by
//
//        python3 tools/calc.py
//
//  from tools/design.py.  Never edit parameters_auto.scad by hand: edit
//  tools/design.py, re-run calc.py, and the 44 validation checks C-01..C-34
//  will tell you whether your change is still geometrically and kinematically
//  legal.
// ===========================================================================

include <parameters_auto.scad>

// ---------------------------------------------------------------------------
// A.  THE PARAMETERS THE BRIEF ASKS FOR BY NAME
//     (exactly these identifiers, so the file can be driven from the CLI:
//      openscad -D 'GEAR_BACKLASH=0.12' main.scad )
// ---------------------------------------------------------------------------

CLOCK_DIAMETER        = 300;      // mm  overall case OD
TOURBILLON_DIAMETER   = 70;       // mm  carriage envelope OD (hard target)
GEAR_MODULE           = 0.7;      // mm  default module for NEW wheels.  Every
                                  //     existing wheel carries its own M_*
                                  //     value below; this one only drives
                                  //     helpers that take a bare module.
GEAR_PRESSURE_ANGLE   = 20;       // deg
GEAR_BACKLASH         = 0.08;     // mm  circumferential backlash at the pitch
                                  //     circle (machined-metal preset)
PLATE_THICKNESS       = 5;        // mm  main plate / bridge plate thickness
SHAFT_DIAMETER        = 4;        // mm  default arbor diameter
AXIAL_CLEARANCE       = 0.10;     // mm  end float per pivot
RADIAL_CLEARANCE      = 0.02;     // mm  pivot-to-jewel radial clearance
BEARING_SEAT_DIAMETER = 6;        // mm  jewel / bush seat diameter
PRINT_TOLERANCE       = 0.20;     // mm  hole compensation for the chosen
                                  //     process (see MANUFACTURING below)
EXPLODED_VIEW         = false;    // bool  true -> exploded_view.scad layout
SHOW_GEAR_TEETH       = true;     // bool  false -> pitch cylinders only
                                  //       (much faster preview)
SHOW_INTERNAL_MECHANISM = true;   // bool  false -> case + dial only
PART_TO_EXPORT        = "";       // string "" = nothing; otherwise the part
                                  //        name listed in parts_export.scad

// ---------------------------------------------------------------------------
// B.  VIEW / RENDER CONTROL
// ---------------------------------------------------------------------------

VIEW                  = "front";  // "front" | "back" | "side" | "top" | "iso"
EXPLODE_FACTOR        = 1.0;      // 0..2  scales the exploded offsets
SHOW_CRYSTAL          = true;
SHOW_DIAL             = true;
SHOW_CASE             = true;
CROSS_SECTION         = false;    // true -> cut the model with the XZ plane
SECTION_ANGLE         = 0;        // deg   rotation of the cutting plane
$fn                   = 96;       // default facet count; raised locally where
                                  //       a small circle needs more

// ---------------------------------------------------------------------------
// C.  GEOMETRIC ANIMATION ONLY  --  NOT A KINEMATIC SOLVER
//     These angles are free inputs.  Turning them moves the wheels, but nothing
//     here enforces the true gear ratios, so an animated view produced with
//     them is a GEOMETRIC ANIMATION and must never be presented as a solved
//     kinematic simulation.  For a ratio-correct animation set
//     DRIVE_FROM_TRAIN = true, which derives every angle from ANGLE_BARREL
//     using the validated ratios in parameters_auto.scad.
// ---------------------------------------------------------------------------

DRIVE_FROM_TRAIN      = true;     // bool
ANGLE_BARREL          = 0;        // deg  master input when DRIVE_FROM_TRAIN
ANGLE_CARRIAGE        = 0;        // deg  used only when DRIVE_FROM_TRAIN=false
ANGLE_ESCAPE          = 0;        // deg  used only when DRIVE_FROM_TRAIN=false
ANGLE_BALANCE         = 0;        // deg  used only when DRIVE_FROM_TRAIN=false

function ang_centre()      = DRIVE_FROM_TRAIN ? -ANGLE_BARREL * ratio_barrel_to_centre       : 0;
function ang_great()       = DRIVE_FROM_TRAIN ? -ANGLE_BARREL * (Z_GREAT_WHEEL / Z_BARREL_GEAR) : 0;
function ang_intermediate()= DRIVE_FROM_TRAIN ?  ang_centre() * (Z_INTER_WHEEL / Z_CENTRE_PINION) : 0;
function ang_carriage()    = DRIVE_FROM_TRAIN ?  ang_intermediate() * (Z_CARRIAGE_RIM / Z_INTER_PINION) : ANGLE_CARRIAGE;
function ang_escape_abs()  = DRIVE_FROM_TRAIN ?  ang_carriage() * (1 + epicyclic_z4_over_zEP) : ANGLE_ESCAPE;
function ang_escape_rel()  = DRIVE_FROM_TRAIN ? -ang_carriage() * epicyclic_z4_over_zEP : ANGLE_ESCAPE;
function ang_hour()        = DRIVE_FROM_TRAIN ?  ang_centre() / motion_ratio_total() : 0;
function motion_ratio_total() = (Z_MINUTE_WHEEL / Z_CANON_PINION) * (Z_HOUR_WHEEL / Z_MINUTE_PINION);

// ---------------------------------------------------------------------------
// D.  MANUFACTURING.  Three complete tolerance presets.  The values are
//     INITIAL, TUNABLE estimates: they must be calibrated against printed /
//     machined coupons before a final build (docs/TOLERANCES.md).
// ---------------------------------------------------------------------------

MANUFACTURING = "metal";          // "fdm" | "resin" | "metal"

// selected preset, resolved once
_PRESET = MANUFACTURING == "fdm"   ? [0.40, 0.40, 0.20, 0.45, 0.40, 2.00, 1.60] :
          MANUFACTURING == "resin" ? [0.15, 0.15, 0.05, 0.18, 0.10, 1.20, 0.80] :
                                     [0.03, 0.10, 0.02, 0.08, 0.00, 0.80, 0.30];

FIT_CLEARANCE   = _PRESET[0];     // mm  added to every hole / subtracted from
                                  //     every shaft for a sliding fit
AXIAL_PLAY      = _PRESET[1];     // mm  end float allowed per part
RADIAL_PLAY     = _PRESET[2];     // mm  radial bearing clearance
TOOTH_BACKLASH  = _PRESET[3];     // mm  circumferential backlash (overrides
                                  //     GEAR_BACKLASH when MANUFACTURING is set)
HOLE_GROWTH     = _PRESET[4];     // mm  printed-hole growth compensation
MIN_WALL        = _PRESET[5];     // mm  thinnest wall this process can hold
MIN_HOLE        = _PRESET[6];     // mm  thinnest hole this process can hold

// Print-shrink compensation: scale factor applied to printed parts.
// 1.000 for machined metal, slightly >1 for FDM (PLA ~0.2-0.5 %).
PRINT_SHRINK_SCALE = MANUFACTURING == "fdm"   ? 1.004 :
                     MANUFACTURING == "resin" ? 1.002 : 1.000;

function fit(d)      = d + FIT_CLEARANCE;      // hole for a shaft of dia d
function shaft(d)    = d - FIT_CLEARANCE;      // shaft for a hole of dia d
function backlash()  = TOOTH_BACKLASH;

// ---------------------------------------------------------------------------
// E.  MATERIAL DENSITIES  (g/mm^3) -- used by the mass and poise estimates
// ---------------------------------------------------------------------------

RHO_BRASS   = 8.50e-3;
RHO_STEEL   = 7.85e-3;
RHO_HARDENED= 7.85e-3;
RHO_TITANIUM= 4.43e-3;   // Ti-6Al-4V, carriage
RHO_ALU     = 2.70e-3;
RHO_RUBY    = 3.98e-3;
RHO_GLASS   = 2.50e-3;
RHO_POM     = 1.41e-3;
RHO_PLA     = 1.24e-3;

MAT_PLATE      = RHO_BRASS;
MAT_BRIDGE     = RHO_BRASS;
MAT_WHEELS     = RHO_BRASS;
MAT_PINIONS    = RHO_STEEL;
MAT_ARBORS     = RHO_HARDENED;
MAT_CARRIAGE   = RHO_TITANIUM;
MAT_BALANCE    = RHO_BRASS;
MAT_SPRING     = RHO_STEEL;

// ---------------------------------------------------------------------------
// F.  Z STACK ACCESSORS  (the authoritative thickness budget)
//     Every row is [z_bottom, z_top, footprint_od]; z = 0 is the FRONT face of
//     the main plate and +Z points towards the dial / viewer.
// ---------------------------------------------------------------------------

ZR_BARREL_COVER   = [-19.5, -18.0];
ZR_BARREL_DRUM    = [-18.0,   1.5];
ZR_MAIN_PLATE     = [ -5.0,   0.0];
ZR_FIXED_FOURTH   = [  1.5,   3.5];
ZR_BARREL_GEAR    = [  2.0,   4.0];
ZR_GREAT_WHEEL    = [  2.0,   4.0];
ZR_GREAT_PINION   = [  2.0,   8.6];
ZR_CENTRE_WHEEL   = [  6.6,   8.6];
ZR_CENTRE_PINION  = [  4.0,   9.5];
ZR_RIM_GEAR       = [  6.4,   8.0];
ZR_INTER_PINION   = [  4.0,   8.0];
ZR_INTER_WHEEL    = [  4.0,   6.0];
ZR_RATCHET        = [  9.0,  12.0];
ZR_CANON_PINION   = [ 10.0,  12.0];
ZR_MINUTE_WHEEL   = [ 10.0,  12.0];
ZR_MINUTE_PINION  = [ 12.0,  14.0];
ZR_HOUR_WHEEL     = [ 12.0,  14.0];
ZR_HOUR_PIPE      = [ 14.0,  29.0];
ZR_MINUTE_PIPE    = [ 12.0,  30.0];
ZR_TOP_BRIDGE     = [ 20.0,  25.0];
ZR_DIAL_RING      = [ 26.0,  28.0];
ZR_HANDS          = [ 28.5,  31.5];
ZR_CRYSTAL        = [ 32.0,  36.0];

Z_CARRIAGE_Z0    = 6.4;           // carriage floor sits here on the movement
function cz(local_z) = Z_CARRIAGE_Z0 + local_z;

MOVEMENT_Z_MIN   = -19.5;
MOVEMENT_Z_MAX   = 36.0;
MOVEMENT_THICKNESS = MOVEMENT_Z_MAX - MOVEMENT_Z_MIN;   // 55.5 mm
CARRIAGE_HEIGHT  = 18.0;          // validated by C-19 (target 12..20)

// ---------------------------------------------------------------------------
// G.  COLOURS  (so an assembly view is readable at a glance)
// ---------------------------------------------------------------------------

C_PLATE     = [0.72, 0.66, 0.42];   // brass plate / bridges
C_WHEEL     = [0.85, 0.76, 0.35];   // brass wheels
C_PINION    = [0.55, 0.57, 0.60];   // steel pinions
C_ARBOR     = [0.35, 0.37, 0.40];   // hardened steel arbors
C_CARRIAGE  = [0.62, 0.66, 0.72];   // titanium carriage
C_BALANCE   = [0.90, 0.80, 0.30];   // gilt balance
C_SPRING    = [0.30, 0.45, 0.75];   // blued mainspring
C_HAIRSPRING= [0.25, 0.55, 0.85];   // blued hairspring
C_RUBY      = [0.80, 0.15, 0.25];   // jewels / pallet stones
C_ESCAPE    = [0.75, 0.75, 0.78];   // escape wheel
C_DIAL      = [0.93, 0.92, 0.88];
C_HANDS     = [0.12, 0.12, 0.14];
C_CASE      = [0.20, 0.20, 0.22];
C_CRYSTAL   = [0.85, 0.92, 0.97, 0.25];
C_SCREW     = [0.45, 0.47, 0.50];

// ---------------------------------------------------------------------------
// H.  FASTENERS  (all bought; see docs/BOM_BOUGHT.csv)
// ---------------------------------------------------------------------------

SCREW_D          = 2.0;      // M2
SCREW_HEAD_D     = 3.8;
SCREW_HEAD_H     = 1.6;
SCREW_CLEARANCE    = SCREW_D + FIT_CLEARANCE + 0.10;
SCREW_PILLAR_D   = 4.0;
PILLAR_SCREW_D   = 1.7;      // M2 thread-forming into brass

// ---------------------------------------------------------------------------
// I.  SMALL HELPERS
// ---------------------------------------------------------------------------

EPS = 0.01;                   // mm  overlap used to make clean boolean cuts
function thk(zr) = zr[1] - zr[0];
function dz(zr)  = zr[0];

// A tube: outer dia, inner dia, height, sitting on z = 0.
module tube(od, id, h, center=false) {
    difference() {
        cylinder(d=od, h=h, center=center);
        if (id > 0) cylinder(d=id, h=h + 2*EPS, center=center);
    }
}

// A counterbored screw hole through a part of thickness h.
module screw_hole(h, d=SCREW_CLEARANCE, head_d=SCREW_HEAD_D, head_h=SCREW_HEAD_H) {
    cylinder(d=d, h=h + 2*EPS, center=true);
    translate([0, 0, h/2 - head_h/2 + EPS])
        cylinder(d=head_d, h=head_h + EPS, center=true);
}
