// ===========================================================================
//  main.scad  --  THE INTEGRATED ENTRY POINT for the tourbillon wall clock.
//
//      openscad main.scad                                    front view
//      openscad -D 'VIEW="iso"' main.scad                     isometric
//      openscad -D 'VIEW="tourbillon"' main.scad              carriage close-up
//      openscad -D 'EXPLODED_VIEW=true' main.scad             exploded, in
//                                                             assembly order
//      openscad -D 'SHOW_GEAR_TEETH=false' main.scad          fast preview:
//                                                             pitch cylinders
//      openscad -D 'SHOW_INTERNAL_MECHANISM=false' main.scad  case + dial only
//      openscad -D 'CROSS_SECTION=true' main.scad             Z stack cut
//      openscad -D 'MANUFACTURING="fdm"' main.scad            FDM tolerances
//      openscad -o stl_output/carriage_floor.stl \
//               -D 'PART_TO_EXPORT="carriage_floor"' main.scad  one STL
//
//  -----------------------------------------------------------------------
//  HOW THIS PROJECT IS SPLIT, AND WHY
//  -----------------------------------------------------------------------
//  The brief allows either a set of independent files or one integrated file
//  with an explanation of how to split it.  This project is BOTH: the modules
//  are already in separate files, and main.scad is the single integrated
//  entry point that includes them.  The dependency order is strict and one
//  direction only -- no file includes a file that includes it:
//
//      parameters_auto.scad   MACHINE GENERATED by tools/calc.py.  Do not edit.
//              ^
//      parameters.scad        every user-editable knob, the tolerance presets,
//              ^              the Z stack, materials, colours, fasteners
//      gear_generator.scad    involute + cycloidal tooth geometry, escape wheel,
//              ^              ratchet.  The only file that knows how to draw a
//              |              tooth.
//      +-------+-------+------------+--------------+---------------+
//      |       |       |            |              |               |
//  mainspring  wheel  motion   escapement   bridges_and    shafts_and
//  _barrel    _train  _works   (carriage-    _plates       _bearings
//      |       |       |        local)  ^         |               |
//      |       |       |            tourbillon    |               |
//      |       |       |            _cage         |               |
//      +-------+-------+------------+-------------+---------------+
//                                   |
//                              assembly.scad     the complete clock, true
//                                   |            positions, front/back/side/
//                                   |            top/iso/section views
//                           exploded_view.scad   the same parts pulled apart
//                                   |            in assembly order
//                          parts_export.scad    one STL per part, with the
//                                   |           Functional / Prototype /
//                                   |           Decorative label of each
//                                main.scad     <- you are here
//
//  To work on one subsystem, open its own file: each one is self-contained
//  (it includes what it needs) and renders on its own.
//
//  -----------------------------------------------------------------------
//  WHAT IS AND IS NOT PROVEN
//  -----------------------------------------------------------------------
//  PROVEN, by tools/calc.py (45 checks C-01..C-34) and tools/profile_check.py
//  (77 measurements P-01..P-08), both of which run clean:
//      centre distances equal m(z1+z2)/2 to the last digit on every mesh
//      ratios close exactly: 24.000 barrel->centre, 60.000 centre->carriage,
//          4.000 epicyclic, 12.000 motion works
//      the carriage turns at 1.000 rpm BECAUSE the balance is at 1.000 Hz,
//          derived from omega_c = f zEP / (zE z4), not assumed
//      every mesh is conjugate: one tooth system and one shared describing
//          circle per mesh, zero tooth collisions over a swept mesh, and a
//          contact ratio measured from the generated profiles (min 1.213)
//      no interference between any two members, in XY and in Z
//      nothing enters the volume the carriage sweeps as it turns
//      every bridge window is at least 1 mm larger than the members declared
//          to pass through it
//      mainspring stress 1400 MPa at full wind, 10.589 J stored, 3.231 barrel
//          turns, run time 3.23 days against a 3.0 day target
//      hairspring stress 750 MPa against a 1400 MPa limit
//      available escape torque 1.2126 N-mm against 0.7384 N-mm required
//      carriage static moment, poise specification and counter-mass
//      thinnest functional wall 1.20 mm against the selected process limit
//
//  NOT PROVEN, and stated as such everywhere it matters:
//      that the clock keeps time.  A CAD model cannot prove that.  Friction,
//      lubrication, amplitude, isochronism, thermal drift, positional error and
//      the hairspring's actual rate all have to be measured on a built movement
//      with a timegrapher.  Read docs/LIMITATIONS.md before building anything.
// ===========================================================================

include <parameters.scad>
include <assembly.scad>
include <exploded_view.scad>
include <parts_export.scad>

// ---------------------------------------------------------------------------
// The single decision point.  PART_TO_EXPORT wins, because exporting one part
// is the only mode where the model must contain nothing else.
// ---------------------------------------------------------------------------
module main() {
    if (PART_TO_EXPORT != "") {
        // parts_export.scad already handles the export, the label check and the
        // print-shrink compensation; nothing else may be in the scene.
        if (part_status(PART_TO_EXPORT) != "Decorative-reference")
            scale([PRINT_SHRINK_SCALE, PRINT_SHRINK_SCALE, PRINT_SHRINK_SCALE])
                part_geometry(PART_TO_EXPORT);
    } else if (EXPLODED_VIEW) {
        exploded_view_annotated();
    } else if (!SHOW_INTERNAL_MECHANISM) {
        // the cosmetic view the brief asks to be kept SEPARATE from the
        // mechanism: case, dial, crystal, hands and nothing else.  This is the
        // only view of this project that is purely cosmetic, and it says so.
        echo("SHOW_INTERNAL_MECHANISM=false: this view is COSMETIC ONLY. ",
             "It contains no functional geometry and proves nothing.");
        dial_ring();
        hour_hand();
        minute_hand();
        case_ring();
        crystal();
        wall_mount();
        back_cover();
    } else if (CROSS_SECTION) {
        section_cut(SECTION_ANGLE);
    } else {
        view_by_name(VIEW);
    }
}

main();
